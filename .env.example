# Copy to .env and fill in. Never commit .env.

# Postgres (policy answers: PolicyChunk table + embeddings)
DATABASE_URL=

# Gemini
GEMINI_API_KEY=
# Optional model overrides (defaults shown)
# GEMINI_CHAT_MODEL=gemini-flash-lite-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# bachpankart API (defaults shown)
# BK_API_BASE_URL=https://api.bachpankart.com/api/consumer/
# BK_SITE_URL=https://bachpankart.com
# Development request budget: on = max 1 request/second, warn past 100/hour, stop at 300/hour.
# Defaults to on outside production.
# BK_RATE_LIMIT=off
